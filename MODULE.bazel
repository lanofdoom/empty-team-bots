"""empty_team_bots — a SourceMod plugin that fills an empty CS:S team with bots."""

module(
    name = "empty_team_bots",
    version = "1.1",
)

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_sourcemod")

git_override(
    module_name = "rules_sourcemod",
    commit = "f0573a67a72dbdf366f23233b5d515498aead03c",
    remote = "https://github.com/kleinpa/rules_sourcemod.git",
)

register_toolchains("@rules_sourcemod//linux:all")
